{
  "lineWidth": 120,
  "indentWidth": 2,
  "useTabs": false,
  "typescript": {
    "quoteStyle": "preferDouble",
    "semiColons": "always"
  },
  "json": {
    "indentWidth": 2,
    "useTabs": false
  },
  "markdown": {
  },
  "toml": {
  },
  "sql": {
  },
  "malva": {
  },
  "markup": {
  },
  "yaml": {
  },
  "shuck": {
  },
  "exec": {
    "cwd": "${configDir}",
    "commands": [
      {
        "command": "rustfmt --edition 2024",
        "exts": ["rs"],
        "cacheKeyFiles": [
          "apps/chorus/src-tauri/Cargo.toml",
          "apps/chorus/src-tauri/crates/blocker/Cargo.toml",
          "apps/chorus/src-tauri/crates/browser-store/Cargo.toml"
        ]
      }
    ]
  },
  "excludes": [
    "**/node_modules",
    "**/*-lock.json",
    "**/Cargo.lock",
    "**/bun.lock",
    "**/target/**",
    "**/dist/**",
    "**/gen/**",
    "apps/chorus/src/components/ui/**"
  ],
  "plugins": [
    "npm:@dprint/typescript@0.96.1",
    "npm:@dprint/json@0.25.2",
    "npm:@dprint/markdown@0.27.1",
    "npm:@dprint/toml@0.9.0",
    "npm:@dprint/sql@0.4.1",
    "npm:dprint-plugin-malva@0.16.0",
    "npm:dprint-plugin-markup@0.27.6",
    "npm:dprint-plugin-yaml@0.6.0",
    "npm:@dprint/shuck@0.2.2",
    "npm:@dprint/exec@0.8.0/plugin.json@9d6234ea05810c775f388c2a4cce82b9116b69294b65e0e1e9d64f1446283ef3"
  ]
}
