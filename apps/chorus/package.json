{
  "name": "@chorus/app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "bun check -b && bun run typecheck:scripts && vite build",
    "format": "dprint fmt",
    "format:check": "dprint check",
    "typecheck:scripts": "bun check -p tsconfig.scripts.json",
    "test:scripts": "bun test ./scripts/__tests__",
    "pre-commit": "bun ./scripts/verify-bun-version.ts && bun run format:check && bun check -b && bun run typecheck:scripts && bun run test:scripts && bun ./scripts/console-log-check.ts",
    "preview": "vite preview",
    "tauri": "tauri",
    "android:init": "tauri android init",
    "android": "tauri android dev",
    "android:install": "bash ./scripts/android.sh",
    "android:wireless": "bun ./scripts/android-wireless-connect.ts",
    "android:wireless:menu": "bun ./scripts/android-wireless-connect.ts --menu",
    "android:wireless:start": "tauri android dev --force-ip-prompt",
    "android:wireless:run": "bun ./scripts/android-wireless-connect.ts && bun run android:wireless:start",
    "ios:init": "tauri ios init",
    "ios": "tauri ios dev",
    "ios:auto": "tauri ios dev",
    "ios:auto:log": "xcrun simctl spawn booted log stream --predicate 'subsystem == \"com.soumitrasaha.chorus\"' --level debug",
    "ios:device": "tauri ios dev",
    "ios:device:auto": "tauri ios dev",
    "ios:device:list": "bash ./scripts/ios-device-helper.sh list",
    "ios:deploy": "bash ./scripts/ios-device-helper.sh deploy",
    "web": "vite --host 127.0.0.1"
  },
  "dependencies": {
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "lucide-react": "^1.59.0",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/bun": "1.4.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "dprint": "0.64.1",
    "typescript": "~6.0.3",
    "vite": "^8.0.16"
  },
  "packageManager": "bun@1.4.3",
  "engines": {
    "bun": "1.4.3"
  }
}
